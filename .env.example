# Replace this placeholder with a unique random value at least 32 characters long.
RECALLAI_JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
RECALLAI_JWT_EXPIRE_MINUTES=60

# Create this key in Google AI Studio. Never commit a real key.
GEMINI_API_KEY=replace-with-your-google-ai-studio-key
GEMINI_MODEL=gemini-3.6-flash

# Local development uses recallai.db when DATABASE_URL is not set.
# On Render, set DATABASE_URL to the managed PostgreSQL internal connection URL.
# DATABASE_URL=postgresql://database-user:database-password@database-host/database-name

# Comma-separated browser origins allowed to call the API from another origin.
# The defaults below support the local frontend development server.
RECALLAI_CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
